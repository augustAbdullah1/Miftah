{
  "name": "miftah",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "mkdir -p web-build && cp -r docs/* web-build/",
    "build:android": "expo export --platform android --output-dir android-build",
    "build:ios": "expo export --platform ios --output-dir ios-build",
    "deploy": "gh-pages -d web-build",
    "predeploy": "npm run build:web",
    "serve": "npx serve docs -p 3000",
    "preview": "python3 -m http.server 8000 --directory docs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "expo": "~53.0.20",
    "expo-auth-session": "^6.2.1",
    "expo-blur": "^14.1.5",
    "expo-crypto": "^14.1.5",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-location": "^18.1.6",
    "expo-notifications": "^0.31.4",
    "expo-status-bar": "~2.2.3",
    "firebase": "^12.0.0",
    "i18next": "^25.3.2",
    "react": "19.0.0",
    "react-i18next": "^15.6.0",
    "react-native": "0.79.5",
    "react-native-animatable": "^1.4.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-super-grid": "^6.0.1",
    "react-native-vector-icons": "^10.2.0",
    "expo-build-properties": "~0.14.8",
    "react-dom": "19.0.0",
    "react-native-web": "^0.20.0",
    "@expo/metro-runtime": "~5.0.4",
    "expo-splash-screen": "~0.30.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "gh-pages": "^6.1.1"
  },
  "private": true
}
